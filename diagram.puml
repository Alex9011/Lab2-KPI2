@startuml
left to right direction
skinparam shadowing false
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #F2F7FD
  BorderColor #365A78
  FontColor #152C40
}
skinparam actorStyle awesome

actor "Читач" as Reader
actor "Працівник бібліотеки" as Staff
actor "Бібліотекар" as Librarian
actor "Каталогізатор" as Cataloger

Librarian --|> Staff
Cataloger --|> Staff

rectangle "Система обліку бібліотеки" {
  usecase "Знайти видання" as UC01
  usecase "Переглянути доступність\nпримірника" as UC02
  usecase "Знайти читача" as UC03
  usecase "Зареєструвати читача" as UC04
  usecase "Оформити видачу\nпримірника" as UC05
  usecase "Повторно видати\nпримірник" as UC06
  usecase "Оформити повернення\nпримірника" as UC07
  usecase "Переглянути історію\nвидач" as UC08
  usecase "Додати видання\nдо каталогу" as UC09
  usecase "Зареєструвати\nновий примірник" as UC10
}
Reader --> UC01
Reader --> UC02
Staff --> UC01
Staff --> UC02
Librarian --> UC03
Librarian --> UC04
Librarian --> UC05
Librarian --> UC07
Librarian --> UC08
Cataloger --> UC09
Cataloger --> UC10
UC05 ..> UC02 : <<include>>
UC05 ..> UC03 : <<include>>
UC06 ..> UC05 : <<extend>>\n[раніше була закрита видача цього примірника]
Librarian --> UC06
@enduml
